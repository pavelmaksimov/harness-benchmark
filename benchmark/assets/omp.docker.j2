FROM {{ base_image }}

USER agent
WORKDIR /workspace

# Install the prebuilt omp binary (no bun runtime needed) from the official
# installer; the version tag must match omp_cli_version in vendor/pins.json.
RUN HOME_DIR="$(getent passwd agent | cut -d: -f6)" && \
    curl -fsSL https://omp.sh/install.sh \
    | PI_INSTALL_DIR="$HOME_DIR/.local/bin" sh -s -- --binary --ref v{{ version }} && \
    mkdir -p "$HOME_DIR/.omp/agent" && \
    "$HOME_DIR/.local/bin/omp" --version
